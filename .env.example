# Frontend environment variables.
#
# Secrets, database URLs, session keys, LLM provider keys, and TTS provider keys
# belong in the backend repo's `.env.local`, not in this frontend app.

# Optional FastAPI backend base URL for local/API mode.
# Leave empty for GitHub Pages/static mode.
VITE_API_BASE_URL=

# Set to true only for static demos that should show profile preview data when
# backend APIs are unavailable. Keep false/empty for real auth deployments.
VITE_ENABLE_PROFILE_PREVIEW=

# Optional local backend path used only by `npm run sync:backend-content`.
# This is not read by the browser bundle.
NOTES_BACKEND_ROOT=/Users/lyukexin/Desktop/notes-system-backend
VITE_ENABLE_FULL_PRODUCT=false
VITE_PILOT_SUBJECT_SLUG=fall-recruiting
VITE_PILOT_START_PATH=/note/fall-recruiting/autumn-recruitment-roadmap.md
